[8.437, "o", "\r\n$ uv run database\r\n"]
[8.453, "o", "\u001b[1t"]
[8.453, "o", "\u001b[c\u001b[?1004h\u001b[?9001h"]
[11.687, "o", "Доступные команды:"]
[11.687, "o", "\r\ncreate_table <table_name> <column:type> ...\r\n"]
[11.687, "o", "list_tables\r\ndrop_table <table_name>\r\n"]
[11.687, "o", "insert into <table_name> values (<value>, ...)\r\nselect from <table_name> [where <column> = <value>]"]
[11.703, "o", "\r\nupdate <table_name> set <column> = <value> where <column> = <value>\r\n"]
[11.703, "o", "delete from <table_name> where <column> = <value>\r\ninfo <table_name>"]
[11.703, "o", "\r\nhelp\r\n"]
[11.703, "o", "exit\r\n"]
[11.703, "o", "Введите команду: "]
[12.359, "i", "create_table users name:str age:int is_active:bool\r"]
[12.359, "o", "\u001b[12;18Hcreate_table users name:str age:int is_active:bool\u001b[12;68H"]
[12.359, "o", "\u001b[12;68H\r\n"]
[12.359, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool"]
[12.359, "o", "\r\n"]
[12.359, "o", "Введите команду: "]
[13.015, "i", "list_tables\r"]
[13.015, "o", "\u001b[14;18Hlist_tables\u001b[14;29H"]
[13.015, "o", "\u001b[14;29H\r\n"]
[13.015, "o", "- users"]
[13.015, "o", "\r\n"]
[13.015, "o", "Введите команду: "]
[13.671, "i", "insert into users values (\"Sergei\", 28, true)\r"]
[13.671, "o", "\u001b[16;18Hinsert into users values (\"Sergei\", 28, true)\u001b[16;63H"]
[13.671, "o", "\u001b[16;63H\r\n"]
[13.671, "o", "Функция insert выполнилась за 0.000 секунд."]
[13.671, "o", "\r\n"]
