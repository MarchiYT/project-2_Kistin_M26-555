[14.328, "o", "\u001b[19;18Hinsert into users values (\"Ivanov, Ivan\", 30, false)\u001b[19;70H"]
[14.328, "o", "\u001b[19;70H\r\n"]
[14.343, "o", "Функция insert выполнилась за 0.008 секунд."]
[14.343, "o", "\r\n"]
[14.343, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\"."]
[14.343, "o", "\r\n"]
